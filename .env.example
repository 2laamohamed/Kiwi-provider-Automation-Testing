# Copy this file to .env (setup.bat does it for you). The defaults below work on staging as-is.

# ===== Business Owner (Provider) website =====
PROVIDER_BASE_URL=https://staging-web.mykiwi.vip
PROVIDER_COUNTRY=EG
# API used to read real values and compare them with the screen
KIWI_API_URL=https://staging.mykiwi.vip/api/v1

# ===== OTP =====
# staging accepts a fixed OTP (9999) for test numbers
OTP_MODE=fixed
OTP_CODE=9999

# ===== Onboarding (npm run test:onboarding) =====
# every run signs up a brand-new provider with a random number that starts with this prefix
TEST_PHONE_PREFIX=1550

# ===== General =====
APP_LOCALE=ar
# true = also run the @destructive tests (they change real data – staging only)
RUN_DESTRUCTIVE=false
